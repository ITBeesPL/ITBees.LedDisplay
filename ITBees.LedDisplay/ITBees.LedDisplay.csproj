<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>ITBees.LedDisplay</PackageId>
    <Version>8.0.1</Version>
    <Authors>ITBees</Authors>
    <Description>Driver for LED information boards and variable-message traffic signs speaking the Elitel line protocol over TCP (SET/CLEAR/COLOR/FONT/BRIGHT/PIX, Windows-1250 text). Builds frames from texts, auto-fitted text boxes, zone layouts and rasterised symbols (arrows, lane-closed cross, B-2 no-entry), keeps a registry of boards with change detection, periodic refresh, liveness probing and status events. No dependency on FAS - usable from device-side apps.</Description>
    <PackageTags>led;display;vms;variable-message-sign;parking;signage;elitel;itbees</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ITBeesPL/ITBees.LedDisplay</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ITBees.LedDisplay.Tests" />
  </ItemGroup>

</Project>
